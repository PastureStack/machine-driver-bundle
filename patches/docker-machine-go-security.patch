diff --git a/commands/create_urfave_test.go b/commands/create_urfave_test.go
new file mode 100644
index 0000000..c5d3a42
--- /dev/null
+++ b/commands/create_urfave_test.go
@@ -0,0 +1,30 @@
+package commands
+
+import (
+	"bytes"
+	"encoding/gob"
+	"testing"
+
+	"github.com/docker/machine/commands/commandstest"
+	"github.com/urfave/cli"
+)
+
+func TestGetDriverOptsNormalizesUrfaveStringSlice(t *testing.T) {
+	values := cli.StringSlice{"ford"}
+	commandLine := &commandstest.FakeCommandLine{
+		LocalFlags: &commandstest.FakeFlagger{
+			Data: map[string]interface{}{
+				"stringslice": &values,
+			},
+		},
+	}
+	driverOpts := getDriverOpts(commandLine, getDriverOptsFlags)
+	actual := driverOpts.StringSlice("stringslice")
+	if len(actual) != 1 || actual[0] != "ford" {
+		t.Fatalf("unexpected normalized string slice: %#v", actual)
+	}
+	var encoded bytes.Buffer
+	if err := gob.NewEncoder(&encoded).Encode(driverOpts); err != nil {
+		t.Fatalf("normalized driver options are not gob encodable: %v", err)
+	}
+}
